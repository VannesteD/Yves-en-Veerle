# Public canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase configuration. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only email configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Yves & Veerle <bestellingen@example.be>

# Generate at least 32 random characters for hashing rate-limit identifiers.
CHECKOUT_RATE_LIMIT_SECRET=
